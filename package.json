{
  "name": "planning-ofppt",
  "version": "1.0.0",
  "private": true,
  "description": "Local desktop dashboard for an OFPPT training institute manager",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
